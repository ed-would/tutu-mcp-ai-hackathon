# Copy to .env.local and fill in your key from https://hub.neuraldeep.ru/app
# API docs: https://neuraldeep.ru/docs · llms.txt: https://neuraldeep.ru/llms.txt

NEURALDEEP_API_KEY=

# Primary: fast JSON intent parsing (free tier)
NEURALDEEP_MODEL=qwen3.6-35b-a3b-noreason

# Fallback for optionaltools-heavy / long reasoning (swap manually if needed)
# gpt-oss-120b | qwen3.6-35b-a3b | gemma-4-31b-noreason
# NEURALDEEP_MODEL_FALLBACK=gpt-oss-120b

# NeuralDeep Hub — https://hub.neuraldeep.ru/app/models

# Fallbak to a model from Yandex AI Studio
YC_API_KEY=
YC_FOLDER_ID=
YС_MODEL=qwen3.6-35b-a3b