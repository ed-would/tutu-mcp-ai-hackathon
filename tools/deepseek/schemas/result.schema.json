{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex-yandex-deepseek-worker/result.schema.json",
  "title": "DeepSeek Worker Result Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "worker_version",
    "task_id",
    "profile",
    "worker",
    "provider",
    "requested_model",
    "reported_model",
    "response_id",
    "request_id",
    "response_status",
    "diagnostic",
    "api_called",
    "started_at",
    "completed_at",
    "duration_ms",
    "input_sha256",
    "supplied_files",
    "git_diff_files",
    "untracked_files",
    "context_stats",
    "usage",
    "warnings",
    "result"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "worker_version": { "type": "string" },
    "task_id": { "type": "string" },
    "profile": { "type": ["string", "null"] },
    "worker": { "const": "deepseek-v4-flash" },
    "provider": { "const": "yandex-ai-studio" },
    "requested_model": { "type": "string" },
    "reported_model": { "type": ["string", "null"] },
    "response_id": { "type": ["string", "null"] },
    "request_id": { "type": ["string", "null"] },
    "response_status": { "type": ["string", "null"] },
    "diagnostic": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "reason"],
          "properties": {
            "code": { "type": "string" },
            "reason": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "api_called": { "type": "boolean" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "input_sha256": { "type": ["string", "null"] },
    "supplied_files": { "type": "array", "items": { "type": "string" } },
    "git_diff_files": { "type": "array", "items": { "type": "string" } },
    "untracked_files": { "type": "array", "items": { "type": "string" } },
    "context_stats": { "type": "object" },
    "usage": {},
    "warnings": { "type": "array", "items": { "type": "string" } },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "findings", "recommendations", "unresolved_questions"],
      "properties": {
        "status": { "enum": ["DONE", "DONE_WITH_CONCERNS", "NEEDS_CONTEXT", "BLOCKED"] },
        "summary": { "type": "string" },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["severity", "claim", "evidence", "confidence"],
            "properties": {
              "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
              "claim": { "type": "string" },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "detail"],
                  "properties": {
                    "path": { "type": "string" },
                    "detail": { "type": "string" }
                  }
                }
              },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "recommendations": { "type": "array", "items": { "type": "string" } },
        "unresolved_questions": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
