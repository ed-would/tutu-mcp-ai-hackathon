{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex-yandex-deepseek-worker/task.schema.json",
  "title": "DeepSeek Worker Task Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "role", "objective", "include", "include_git_diff", "git_diff_paths", "constraints"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "profile": {
      "type": ["string", "null"],
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "role": { "type": "string", "minLength": 1, "maxLength": 200 },
    "objective": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "include": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "include_git_diff": { "type": "boolean" },
    "git_diff_paths": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "constraints": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "max_files": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "max_file_bytes": { "type": "integer", "minimum": 1024, "maximum": 1000000 },
    "max_context_bytes": { "type": "integer", "minimum": 16384, "maximum": 2000000 },
    "max_git_diff_bytes": { "type": "integer", "minimum": 4096, "maximum": 1000000 },
    "max_output_tokens": { "type": "integer", "minimum": 512, "maximum": 32768 },
    "timeout_ms": { "type": "integer", "minimum": 10000, "maximum": 1200000 }
  }
}
